{
  "name": "adinfo-eleventy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "eleventy --serve",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "check:publishing": "node scripts/check-publishing.mjs",
    "dev:worker": "npm run build && wrangler dev --ip 127.0.0.1",
    "check:worker": "node --test test/contact.test.mjs test/contact-client.test.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "cheerio": "1.0.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
