---
layout: base.njk
---
<article class="py-14 sm:py-20">
  <header class="mx-auto max-w-3xl"><p class="text-xs font-semibold uppercase tracking-widest text-brand-700">ADInfo</p><h1 class="mt-4 text-4xl font-semibold tracking-tight text-zinc-900 sm:text-5xl">{{ title | escape }}</h1><p class="mt-6 text-lg leading-8 text-zinc-600">{{ description | escape }}</p></header>
  {% if image %}<figure class="mx-auto my-10 max-w-3xl"><img class="aspect-[16/9] w-full rounded-2xl object-cover" src="{{ image }}" alt="{{ imageAlt | escape }}">{% if imageCredit %}<figcaption class="mt-3 text-center text-xs text-zinc-500">{{ imageCredit | safe }}</figcaption>{% endif %}</figure>{% endif %}
  <div class="article-prose mx-auto mt-10 max-w-3xl" data-article-body>{{ content | safe }}</div>
</article>
