---
layout: base.njk
---
<article class="py-12 sm:py-16">
  <header class="mx-auto max-w-3xl">
    <a href="/archive/" class="text-sm font-medium text-zinc-500 hover:text-brand-700">← All articles</a>
    <p class="mt-10 text-xs font-semibold uppercase tracking-widest text-brand-700">{{ topic or 'Perspectives' }}</p>
    <h1 class="mt-4 text-4xl font-semibold leading-tight tracking-tight text-zinc-900 sm:text-5xl">{{ title | escape }}</h1>
    <p class="mt-6 text-lg leading-8 text-zinc-600">{{ description | escape }}</p>
    <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-zinc-500"><a class="font-medium text-zinc-800 hover:text-brand-700" href="/author/alexandre/">{{ site.author }}</a><span aria-hidden="true">·</span><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time><span aria-hidden="true">·</span><span>{{ content | readingTime }}</span></div>
  </header>
  {% if image %}<img class="my-10 max-h-[580px] w-full rounded-2xl object-cover sm:my-12" src="{{ image }}" alt="{{ imageAlt | escape }}" fetchpriority="high">{% endif %}
  <div class="article-prose mx-auto max-w-3xl" data-article-body>{{ content | safe }}</div>
  <footer class="mx-auto mt-12 flex max-w-3xl flex-wrap items-center justify-between gap-4 border-t border-zinc-200 pt-8 text-sm"><a class="font-medium text-brand-700" href="/archive/">← More perspectives</a><a class="contact-button" href="/contact/">Continue the conversation ↗</a></footer>
</article>
