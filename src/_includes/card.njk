<article class="group overflow-hidden rounded-2xl border border-zinc-200 bg-white transition-shadow hover:shadow-lg hover:shadow-zinc-200/50">
  <a href="{{ post.url }}" class="block overflow-hidden" tabindex="-1" aria-hidden="true">
    <img class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105" src="{{ post.data.image }}" alt="" loading="lazy" decoding="async" eleventy:widths="400,640,800" sizes="(min-width: 1024px) 336px, (min-width: 768px) 44vw, calc(100vw - 48px)">
  </a>
  <div class="p-6 sm:p-7">
    <div class="mb-4 flex flex-wrap items-center gap-3 text-xs font-medium"><span class="rounded-full bg-brand-50 px-3 py-1 text-brand-700">{{ post.data.topic or 'Perspectives' }}</span><time class="text-zinc-500" datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></div>
    <h3 class="text-xl font-semibold leading-snug tracking-tight text-zinc-900"><a class="hover:text-brand-700" href="{{ post.url }}">{{ post.data.title | escape }}</a></h3>
    <p class="mt-3 text-sm leading-7 text-zinc-600">{{ post.data.description | escape }}</p>
    <div class="mt-6 flex items-center justify-between gap-3 text-xs"><span class="text-zinc-500">{{ post.templateContent | readingTime }}</span><a href="{{ post.url }}" class="font-semibold text-brand-700" aria-label="Read {{ post.data.title | escape }}">Read article <span aria-hidden="true">→</span></a></div>
  </div>
</article>
